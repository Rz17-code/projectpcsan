# Penyimpanan data. "file" = folder ./data di laptop ini (mode localhost).
# Di Vercel otomatis memakai Upstash Redis bila KV_REST_API_URL & KV_REST_API_TOKEN ada (lihat README "Deploy ke Vercel").
PCSAN_STORAGE=file

# Password bersama untuk masuk aplikasi. Kosong = tanpa password (biasa untuk localhost).
PCSAN_PASSWORD=
